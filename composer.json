{
  "name": "cmdstan/php",
  "description": "A PHP interface to CmdStan inspired by CmdStanR",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-json": "*"
  },
  "suggest": {
    "ext-ffi": "Required for model methods (log_prob, gradients, constrain/unconstrain) and expose_functions()"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "CmdStan\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "CmdStan\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group integration --exclude-group compatibility",
    "test:integration": "phpunit --group integration",
    "lint": "php scripts/lint.php",
    "test:compatibility": "phpunit --group compatibility"
  }
}
